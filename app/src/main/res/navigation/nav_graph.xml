<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/mainMenuFragment">
    <fragment
        android:id="@+id/mainMenuFragment"
        android:name="com.leo.zamtrivia.ui.menu.MainMenuFragment"
        android:label="Main Menu">
        <action
            android:id="@+id/action_mainMenuFragment_to_modeSelectionFragment"
            app:destination="@id/modeSelectionFragment" />
        <action
            android:id="@+id/action_mainMenuFragment_to_leaderboardFragment"
            app:destination="@id/leaderboardFragment" />
    </fragment>
    <fragment
        android:id="@+id/modeSelectionFragment"
        android:name="com.leo.zamtrivia.ui.mode.ModeSelectionFragment"
        android:label="Mode Selection">
        <action
            android:id="@+id/action_modeSelectionFragment_to_categoryFragment"
            app:destination="@id/categoryFragment" />
        <action
            android:id="@+id/action_modeSelectionFragment_to_quizFragment"
            app:destination="@id/quizFragment" />
    </fragment>
    <fragment
        android:id="@+id/categoryFragment"
        android:name="com.leo.zamtrivia.ui.category.CategoryFragment"
        android:label="Categories">
        <action
            android:id="@+id/action_categoryFragment_to_quizFragment"
            app:destination="@id/quizFragment" />
    </fragment>
    <fragment
        android:id="@+id/quizFragment"
        android:name="com.leo.zamtrivia.ui.quiz.QuizFragment"
        android:label="Quiz">
        <argument
            android:name="playerName"
            app:argType="string" />
        <argument
            android:name="categoryName"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="isRandomMode"
            android:defaultValue="false"
            app:argType="boolean" />
        <action
            android:id="@+id/action_quizFragment_to_resultFragment"
            app:destination="@id/resultFragment" />
    </fragment>
    <fragment
        android:id="@+id/resultFragment"
        android:name="com.leo.zamtrivia.ui.result.ResultFragment"
        android:label="Results">
        <action
            android:id="@+id/action_resultFragment_to_leaderboardFragment"
            app:destination="@id/leaderboardFragment" />
        <action
            android:id="@+id/action_resultFragment_to_mainMenuFragment"
            app:destination="@id/mainMenuFragment"
            app:popUpTo="@id/mainMenuFragment"
            app:popUpToInclusive="true" />
    </fragment>
    <fragment
        android:id="@+id/leaderboardFragment"
        android:name="com.leo.zamtrivia.ui.leaderboard.LeaderboardFragment"
        android:label="Leaderboard" />
</navigation>